{
  "expo": {
    "name": "Shussapp",
    "slug": "shussapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "shussapp",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "app.shussapp",
      "usesAppleSignIn": true,
      "supportsTablet": false
    },
    "android": {
      "package": "app.shussapp",
      "adaptiveIcon": {
        "backgroundColor": "#F0782E",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0b0d0c",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-secure-store",
      "expo-localization",
      "expo-apple-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "Shussapp uses your photos so you can add a picture of the mat to a game.",
          "cameraPermission": "Shussapp uses the camera so you can snap the mat after a game."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
